    {
      "id": "foot",
      "type": "text",
      "x": 40,
      "y": 830,
      "strokeColor": "#2b1d12",
      "text": "Gods are petitioned; Forces are bargained with and remember every bargain. The Three Laws (Balance, Truth, Memory) bind mortal craft only. [Saga]",
      "fontSize": 15,
      "fontFamily": 5,
      "createdAt": "2026-10-13T22:51:10.540Z",
