      "version": 1
    },
    {
      "id": "t96",
      "type": "text",
      "x": 1188,
      "y": 250.5,
      "width": 300.618,
      "height": 112.5,
      "backgroundColor": "transparent",
      "strokeColor": "#2b1d12",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "text": "What you take you give back. The\nbill is shown on the page: memory\nfirst, then health, then years,\nthen madness. A cost can be\ndeferred, never refused.",
      "fontSize": 18,
      "fontFamily": 5,
      "groupIds": [],
      "locked": false,
      "roundness": null,
      "fillStyle": "solid",
      "boundElements": [],
      "createdAt": "2026-10-12T20:23:30.349Z",
      "updatedAt": "2026-10-12T20:23:30.349Z",
      "version": 1
    },
