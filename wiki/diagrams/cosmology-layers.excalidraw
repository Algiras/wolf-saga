      "y": 492,
      "width": 256.33799999999997,
      "height": 45,
      "backgroundColor": "transparent",
      "strokeColor": "#58180D",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "text": "\"Tiesa galingesnė už bet kokį\nburtą\"",
      "fontSize": 18,
      "fontFamily": 5,
      "groupIds": [],
      "locked": false,
      "roundness": null,
      "fillStyle": "solid",
      "boundElements": [],
      "createdAt": "2026-10-12T20:23:30.349Z",
