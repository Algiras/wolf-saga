      "version": 1
    },
    {
      "id": "t151",
      "type": "text",
      "x": 0,
      "y": 1040,
      "width": 838.816,
      "height": 20,
      "backgroundColor": "transparent",
      "strokeColor": "#58180D",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "text": "The baptism saves Lithuania from the Order and damns it to its own unfed dead. Neither choice was clean.",
      "fontSize": 16,
      "fontFamily": 5,
      "groupIds": [],
      "locked": false,
      "roundness": null,
      "fillStyle": "solid",
