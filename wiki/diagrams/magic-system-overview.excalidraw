    {
      "id": "title",
      "type": "text",
      "x": 40,
      "y": 20,
      "strokeColor": "#58180D",
      "text": "The craft at a glance: gods, forces, schools, elements and the price",
      "fontSize": 30,
      "fontFamily": 5,
      "createdAt": "2026-10-13T22:51:10.540Z",
      "updatedAt": "2026-10-13T22:51:10.540Z",
      "version": 1
    },
    {
      "id": "L1",
      "type": "rectangle",
      "x": 40,
      "y": 90,
      "width": 520,
      "height": 120,
      "backgroundColor": "#d6b25e",
      "strokeColor": "#58180D",
      "strokeWidth": 2,
      "label": {
        "text": "LAYER I · THE GODS (Dievai)\nsource, ancient, mostly indifferent\nPerkūnas · Velnias · Žemyna · Gabija\nBangpūtys · Vėjopatis · Praurimė"
      },
      "fontSize": 18,
      "fontFamily": 5,
      "createdAt": "2026-10-13T22:51:10.540Z",
      "updatedAt": "2026-10-13T22:51:10.540Z",
      "version": 1
    },
    {
      "id": "L2",
      "type": "rectangle",
      "x": 40,
      "y": 260,
      "width": 520,
      "height": 120,
      "backgroundColor": "#e8b4a8",
      "strokeColor": "#58180D",
      "strokeWidth": 2,
      "label": {
        "text": "LAYER II · THE FORCES (Galios)\nhungry, partisan, meddling in history\nRoot-Mother · Perkūno Rūstybė\nShadow-Seller · Amber Queen · egregores"
      },
      "fontSize": 18,
      "fontFamily": 5,
      "createdAt": "2026-10-13T22:51:10.540Z",
      "updatedAt": "2026-10-13T22:51:10.540Z",
      "version": 1
    },
    {
      "id": "L3",
      "type": "rectangle",
      "x": 40,
      "y": 430,
      "width": 520,
      "height": 120,
      "backgroundColor": "#b9c7a0",
      "strokeColor": "#58180D",
      "strokeWidth": 2,
      "label": {
        "text": "LAYER III · THE CRAFT (Senovės Kalba)\nmortal words, mortal blood, mortal cost\nbound by Balance, Truth and Memory"
      },
      "fontSize": 18,
      "fontFamily": 5,
      "createdAt": "2026-10-13T22:51:10.540Z",
      "updatedAt": "2026-10-13T22:51:10.540Z",
      "version": 1
    },
