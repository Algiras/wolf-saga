    {
      "id": "t150",
      "type": "text",
      "x": 0,
      "y": 1014,
      "width": 1291.9360000000001,
      "height": 20,
      "backgroundColor": "transparent",
      "strokeColor": "#2b1d12",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "text": "Before 1382 the spirits keep custom. After 1387 they are owed nothing and give nothing: swamps eat trackers, groves breed ravenous vėlės, aitvarai turn arsonists.",
      "fontSize": 16,
      "fontFamily": 5,
      "groupIds": [],
      "locked": false,
      "roundness": null,
      "fillStyle": "solid",
      "boundElements": [],
      "createdAt": "2026-10-12T20:28:36.246Z",
