    },
    {
      "id": "cost_t",
      "type": "text",
      "x": 40,
      "y": 600,
      "strokeColor": "#58180D",
      "text": "THE COST FLOW · Kiek paimi, tiek atiduok (as much as you take, give back)",
      "fontSize": 22,
      "fontFamily": 5,
      "createdAt": "2026-10-13T22:51:10.540Z",
      "updatedAt": "2026-10-13T22:51:10.540Z",
      "version": 1
    },
    {
      "id": "c1",
      "type": "rectangle",
      "x": 40,
      "y": 650,
      "width": 260,
      "height": 150,
      "backgroundColor": "#b9c7a0",
      "strokeColor": "#58180D",
      "label": {
        "text": "1 · ASK\nElement + tau / man + verb\nspoken aloud, true intent"
      },
      "fontSize": 17,
      "fontFamily": 5,
      "createdAt": "2026-10-13T22:51:10.540Z",
      "updatedAt": "2026-10-13T22:51:10.540Z",
      "version": 1
    },
    {
      "id": "c2",
      "type": "rectangle",
      "x": 340,
      "y": 650,
      "width": 260,
      "height": 150,
      "backgroundColor": "#d6b25e",
      "strokeColor": "#58180D",
      "label": {
        "text": "2 · TIME\nAt zenith: cost halved\nOff zenith: doubled\nConsecrated stone: doubled"
      },
      "fontSize": 17,
      "fontFamily": 5,
      "createdAt": "2026-10-13T22:51:10.540Z",
      "updatedAt": "2026-10-13T22:51:10.540Z",
      "version": 1
    },
    {
      "id": "c3",
      "type": "rectangle",
      "x": 640,
      "y": 650,
      "width": 260,
      "height": 150,
      "backgroundColor": "#e8b4a8",
      "strokeColor": "#58180D",
      "label": {
        "text": "3 · THE CASTER PAYS\nbody, senses, memory:\nthirst, blindness, stone,\nlost voice, lost face"
      },
      "fontSize": 17,
      "fontFamily": 5,
      "createdAt": "2026-10-13T22:51:10.540Z",
      "updatedAt": "2026-10-13T22:51:10.540Z",
      "version": 1
    },
    {
      "id": "c4",
      "type": "rectangle",
      "x": 940,
      "y": 650,
      "width": 260,
      "height": 150,
      "backgroundColor": "#fffaf0",
      "strokeColor": "#58180D",
      "label": {
        "text": "4 · SURETY\nJo skola, mano skola:\na binder pays part,\nuntil the surety ends"
      },
      "fontSize": 17,
      "fontFamily": 5,
      "createdAt": "2026-10-13T22:51:10.540Z",
      "updatedAt": "2026-10-13T22:51:10.540Z",
      "version": 1
    },
    {
      "id": "c5",
      "type": "rectangle",
      "x": 1240,
      "y": 650,
      "width": 260,
      "height": 150,
      "backgroundColor": "#f3e6c4",
      "strokeColor": "#58180D",
      "label": {
        "text": "5 · UNPAID\ndeferred costs compound:\nmemory, health, years,\nmadness, death"
      },
      "fontSize": 17,
      "fontFamily": 5,
      "createdAt": "2026-10-13T22:51:10.540Z",
      "updatedAt": "2026-10-13T22:51:10.540Z",
      "version": 1
    },
