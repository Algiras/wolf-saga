    {
      "id": "t95",
      "type": "text",
      "x": 1188,
      "y": 216,
      "width": 214.488,
      "height": 22.5,
      "backgroundColor": "transparent",
      "strokeColor": "#58180D",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "text": "\"Kiek paimi, tiek atiduok\"",
      "fontSize": 18,
      "fontFamily": 5,
      "groupIds": [],
      "locked": false,
      "roundness": null,
      "fillStyle": "solid",
      "boundElements": [],
      "createdAt": "2026-10-12T20:23:30.349Z",
