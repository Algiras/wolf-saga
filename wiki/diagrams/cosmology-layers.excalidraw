    {
      "id": "t102",
      "type": "text",
      "x": 1188,
      "y": 802.5,
      "width": 296.20799999999997,
      "height": 112.5,
      "backgroundColor": "transparent",
      "strokeColor": "#2b1d12",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "text": "The land remembers every working\nand keeps its residue. Amber\nstores memory (Saulė's grief) and\nanswers to the truth of whoever\nholds it.",
      "fontSize": 18,
      "fontFamily": 5,
      "groupIds": [],
