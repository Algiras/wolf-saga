      "version": 1
    },
    {
      "id": "t99",
      "type": "text",
      "x": 1188,
      "y": 549,
      "width": 282.87,
      "height": 112.5,
      "backgroundColor": "transparent",
      "strokeColor": "#2b1d12",
      "strokeWidth": 1,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "text": "Hide, reveal, heal, show\npossibilities. Never make anyone\nsee what is not there: no\nglamours, no illusions. The Krėva\nfog is real fog.",
      "fontSize": 18,
      "fontFamily": 5,
      "groupIds": [],
      "locked": false,
      "roundness": null,
      "fillStyle": "solid",
      "boundElements": [],
      "createdAt": "2026-10-12T20:23:30.350Z",
